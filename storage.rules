rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Documentos por usuario autenticado: /users/{uid}/documents/*
    match /users/{userId}/documents/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId
        && (request.resource == null || request.resource.size < 50 * 1024 * 1024); // 50MB max
    }
  }
}
